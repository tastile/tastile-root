{
  "_comment": "Bash PreToolUse guards run through .claude/hooks/hook-dispatch.mjs. Routine policy checks use Bun; PowerShell is selected only for commands that may publish repository state.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-dispatch.mjs",
              "claude"
            ],
            "timeout": 1200,
            "statusMessage": "Checking Tastile command policy"
          }
        ]
      }
    ]
  }
}
