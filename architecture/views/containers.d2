      style.fill: "#eeeeee"
    }
    ext_apple_identity: "Sign in with Apple" {
      style.fill: "#eeeeee"
    }
    ext_stripe: "Stripe" {
      style.fill: "#eeeeee"
    }
    ext_email: "Transactional email provider" {
      style.fill: "#eeeeee"
    }
    ext_fcm: "Firebase Cloud Messaging" {
      style.fill: "#eeeeee"
      style.stroke-dash: 4
    }
    ext_webpush: "Web Push services" {
      style.fill: "#eeeeee"
      style.stroke-dash: 4
    }
    ext_google_calendar: "External calendars" {
      style.fill: "#eeeeee"
      style.stroke-dash: 4
    }
    ext_github: "GitHub" {
      style.fill: "#eeeeee"
    }
    ext_google_play: "Google Play" {
      style.fill: "#eeeeee"
    }
    ext_scheduler: "Cloud Scheduler / Cloud Tasks" {
      style.fill: "#eeeeee"
      style.stroke-dash: 4
    }
  }
  sys_tastile: "Tastile" {
    style.fill: "#f4f8ff"
    ctr_core_api: "Core API\\n[Rust / axum / SQLx (crates-v1/api)]"
    ctr_core_worker: "Core Worker\\n[Rust (crates-v1/worker)]"
    ctr_core_migrate: "Core Migration Job\\n[Rust one-shot job (crates-v1/storage migrations)]" {
      style.stroke-dash: 4
    }
    ctr_domain_db: "Domain database\\n[PostgreSQL 17 (database `tastile`)]" {
      shape: cylinder
    }
    ctr_web: "Web application\\n[Next.js 16 / React 19 / TypeScript / Bun (standalone server)]"
    ctr_auth_db: "Auth database\\n[PostgreSQL 17 (database `tastile_auth`, least-privilege role)]" {
      shape: cylinder
    }
    ctr_edge: "Edge\\n[Cloudflare DNS / TLS / WAF / Workers]"
    ctr_downloads: "Download distribution\\n[Cloudflare R2 bucket + custom domain download.tastile.app]" {
      shape: cylinder
    }
    ctr_media: "User media storage\\n[Cloudflare R2 (S3 API) + custom domain media.tastile.app]" {
      shape: cylinder
      style.stroke-dash: 4
    }
    ctr_android: "Android app\\n[Kotlin / Jetpack Compose]"
    ctr_desktop: "Windows desktop app\\n[C# / WinUI 3 / .NET]"
    ctr_cli: "CLI / TUI\\n[Rust / clap / ratatui]"
    ctr_ios: "iOS / macOS apps\\n[Swift / SwiftUI (未着手)]" {
      style.stroke-dash: 4
    }
  }
}

