{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tastile.app/schema/architecture/roadmap.json",
  "title": "Tastile migration roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "as_of", "milestones"],
  "properties": {
    "schema": { "const": "tastile.architecture/roadmap@1" },
    "as_of": { "$ref": "common.json#/$defs/asOf" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "exit_criteria", "status"],
        "properties": {
          "id": { "$ref": "common.json#/$defs/id", "pattern": "^ms\\." },
          "title": { "$ref": "common.json#/$defs/text" },
          "repos": { "$ref": "common.json#/$defs/refList" },
          "depends_on": { "$ref": "common.json#/$defs/refList" },
          "authority": { "enum": ["operator"] },
          "work": { "type": "array", "items": { "type": "string" } },
          "exit_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "tracking": { "type": "array", "items": { "type": "string", "pattern": "^tastile/[a-z0-9-]+#[0-9]+$" } },
          "status": { "enum": ["planned", "in_progress", "done", "cancelled"] }
        }
      }
    }
  }
}
