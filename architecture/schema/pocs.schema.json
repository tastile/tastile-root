{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tastile.app/schema/architecture/pocs.json",
  "title": "Tastile PoCs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "as_of", "pocs"],
  "properties": {
    "schema": { "const": "tastile.architecture/pocs@1" },
    "as_of": { "$ref": "common.json#/$defs/asOf" },
    "pocs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "hypothesis", "method", "decides", "status", "criteria"],
        "properties": {
          "id": { "$ref": "common.json#/$defs/id", "pattern": "^poc\\." },
          "title": { "$ref": "common.json#/$defs/text" },
          "hypothesis": { "$ref": "common.json#/$defs/text" },
          "method": { "$ref": "common.json#/$defs/text" },
          "decides": { "$ref": "common.json#/$defs/refList" },
          "status": { "enum": ["planned", "running", "passed", "failed", "partial"] },
          "executed_at": { "$ref": "common.json#/$defs/asOf" },
          "evidence": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "metric", "op", "threshold"],
              "properties": {
                "id": { "type": "string", "pattern": "^c[0-9]+$" },
                "metric": { "$ref": "common.json#/$defs/text" },
                "op": { "enum": ["<", "<=", "==", ">=", ">", "subset_of"] },
                "threshold": {},
                "observed": {},
                "result": { "enum": ["pass", "fail"] },
                "note": { "$ref": "common.json#/$defs/text" }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "action"],
              "properties": {
                "id": { "$ref": "common.json#/$defs/id", "pattern": "^f\\." },
                "text": { "$ref": "common.json#/$defs/text" },
                "action": { "$ref": "common.json#/$defs/text" }
              }
            }
          }
        },
        "allOf": [
          { "if": { "properties": { "status": { "enum": ["passed", "failed", "partial"] } } }, "then": { "required": ["executed_at", "evidence"] } }
        ]
      }
    }
  }
}
