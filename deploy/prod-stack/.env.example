# Schema only — values are injected from Infisical at deploy time
# (/tastile/prod on the self-hosted instance). Never commit real values.

# --- Images (preferred path: prebuilt, tag- or digest-pinned) ---
TASTILE_CORE_IMAGE=
TASTILE_CORE_TAG=
TASTILE_WEB_IMAGE=
TASTILE_WEB_TAG=
# Local-build fallback (mutually exclusive with *_IMAGE):
TASTILE_CORE_DIR=
TASTILE_WEB_DIR=
TASTILE_WEB_VERSION=

# --- PostgreSQL ---
TASTILE_PG_USER=tastile_admin
TASTILE_PG_PASSWORD=
TASTILE_CORE_DB=tastile
TASTILE_CORE_DB_USER=tastile_core
TASTILE_CORE_DB_PASSWORD=
TASTILE_AUTH_DB=tastile_auth
TASTILE_AUTH_DB_USER=tastile_auth
TASTILE_AUTH_DB_PASSWORD=
TASTILE_DATABASE__MAX_CONNECTIONS=10

# --- Resource ceilings (NF04-R05 / root#145) ---
# cgroup CPU/memory limits per service (4 vCPU / 8 GiB VM budget).
# TASTILE_DB_CPUS=1.0        TASTILE_DB_MEMORY=2G
# TASTILE_API_CPUS=1.25      TASTILE_API_MEMORY=2G
# TASTILE_WORKER_CPUS=0.75   TASTILE_WORKER_MEMORY=768M
# TASTILE_WEB_CPUS=0.5       TASTILE_WEB_MEMORY=1G
# TASTILE_CADDY_CPUS=0.25    TASTILE_CADDY_MEMORY=128M
# TASTILE_CLOUDFLARED_CPUS=0.25  TASTILE_CLOUDFLARED_MEMORY=128M
# Filesystem free-space floor shared by api + worker (bytes). Below it,
# mutating API requests get 503 + Retry-After and worker drains defer.
TASTILE_DISK_MIN_FREE_BYTES=4294967296

# --- Core API / Worker ---
TASTILE_WEB_BRIDGE_SECRET=
TASTILE_DELIVERY_PROVIDER=fake
RUST_LOG=info

# --- Web ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# --- Public hostnames (placeholders until DNS transfer is approved) ---
APP_DOMAIN=
API_DOMAIN=

# --- Ingress ---
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
COMPOSE_PROJECT_NAME=tastile-prod

# --- Optional Cloudflare Tunnel connector (profile "tunnel") ---
TUNNEL_TOKEN=
