# Caddy reverse proxy for the Native-first production stack (root#141, NF04-R02).
# APP_DOMAIN serves the Next.js standalone web app; API_DOMAIN serves the
# tastile-core HTTP API. Both names are placeholders until DNS transfer is
# approved (approval boundary). Caddy provisions internal TLS automatically
# when the domains resolve; behind cloudflared the tunnel terminates public
# TLS and caddy may serve plain HTTP internally.
#
# Resource ceilings (NF04-R05 / root#145, root#177) — two distinct layers:
#
# EDGE (this file's `servers` block + compose `ulimits`): bounds what external
# clients can make Caddy itself consume.
#   - `timeouts` bound slow clients in TIME (slowloris): a connection that
#     stalls before/during a request is reaped. `write` stays unset so
#     long-lived sync streams are not cut.
#   - `max_header_size` bounds per-request header memory regardless of
#     concurrency.
#   - `request_body max_size` bounds per-request body memory per site.
#   - Stock Caddy has NO option for a total inbound TCP connection count;
#     that ceiling is enforced by the container `nofile` ulimit in
#     compose.yaml (each connection costs ~1 fd). HTTP/2 concurrent streams
#     per connection are bounded by the Go http2 server default
#     (MAX_CONCURRENT_STREAMS).
#
# UPSTREAM (per `reverse_proxy` block): bounds load placed on backends.
#   - `unhealthy_request_count` marks an upstream down after that many
#     simultaneous in-flight requests; with one upstream per site the proxy
#     fails fast once `unhealthy_request_count` requests are already being
#     served, so excess requests error instead of queueing without bound.
#   - `max_conns_per_host` bounds the TCP fan-out to each backend.
#   These do NOT limit edge connections that never complete a request.
{
	servers {
		max_header_size 64KB
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$APP_DOMAIN} {
	request_body {
		max_size 32MB
	}
	reverse_proxy web:3000 {
		transport http {
			max_conns_per_host 256
		}
		unhealthy_request_count 256
		fail_duration 30s
		max_fails 3
	}
}

{$API_DOMAIN} {
	request_body {
		max_size 32MB
	}
	reverse_proxy api:31400 {
		transport http {
			max_conns_per_host 512
		}
		unhealthy_request_count 512
		fail_duration 30s
		max_fails 3
	}
}
