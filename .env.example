# =============================================================================
# Tastile root environment schema
# =============================================================================
# Plaintext values belong only in .env / .env.development / .env.production
# (gitignored). This file enumerates every env-var KEY consumed by repo-root
# scripts; the loader at scripts/sops-decrypt.ts decrypts values on demand.
# See AGENTS.md "Immutability: schema in *.example, values in .env*".
# =============================================================================

# ---- SOPS env-decryption loader (scripts/sops-decrypt.ts) ------------------
# Selects the env entry in scripts/sops.config.ts.
# Valid values: development | staging | production
TASTILE_ENV=

# ---- Web gate orchestration (scripts/orchestration/invoke-web-gate.ps1) ---
# Absolute base URL of the Rust core API consumed by tastile-web.
# Must not include a trailing slash.
TASTILE_RUST_API_URL=

# Daemon base URL exposed to the browser at Next.js build time.
# NEXT_PUBLIC_* is statically inlined per AGENTS.md / Next.js convention.
NEXT_PUBLIC_DAEMON_BASE_URL=

# ---- Workspace checks (scripts/check-workspace.ps1) ------------------------
# Absolute path to a JDK 17 install used for Android (Gradle/AGP) builds.
# Setting this in a shell temporarily is sufficient — no committed value.
JAVA_HOME=
